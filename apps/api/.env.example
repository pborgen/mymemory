# PostgreSQL connection string. The database must have the pgvector extension
# available — the app runs `CREATE EXTENSION IF NOT EXISTS vector` on startup.
# Local Mac default (see docker-compose.yml / `npm run db:up`):
POSTGRES_URL=postgresql://postgres:postgres@localhost:5544/mymemory

# Server port.
PORT=8080

# Enable dev auth via the `x-user-email` header and expose dev accounts.
# NEVER set true on a public AWS URL — anyone can spoof identity and burn LLM spend.
ALLOW_DEV_AUTH_HEADERS=true

# Runtime environment. Set to "production" on App Runner (Terraform does this).
# In production the API refuses to boot if ALLOW_DEV_AUTH_HEADERS=true,
# GOOGLE_CLIENT_ID is empty, or CORS_ORIGINS is open (*).
# ENVIRONMENT=development

# Comma-separated browser origins allowed by CORS. Empty → * (local only).
# Prod example: https://xxxxx.us-east-1.awsapprunner.com,https://app.example.com
# CORS_ORIGINS=

# Super admin — seeded as profiles.role=admin on every API startup. This is the
# only env-defined admin; all other admins are granted in the DB / Admins UI.
# Example (matches a DEV_ACCOUNTS email for local use):
SUPER_ADMIN_EMAIL=paul@dev.local

# Per-user rate limits on Bedrock-costly endpoints (requests / rolling 60s).
# RATE_LIMIT_CHAT_PER_MIN=30
# RATE_LIMIT_STORE_PER_MIN=20

# Redis connection string for the shared prompt cache. Optional: if unset, the
# prompt resolver reads straight through to Postgres (fine for local dev).
# REDIS_URL=redis://localhost:6379/0

# Google OAuth client id for production sign-in (leave blank in local Mac/dev).
# Required when ENVIRONMENT=production.
GOOGLE_CLIENT_ID=

# Generation and embeddings are configured separately (one server often provides
# only one of them — e.g. a vLLM chat server has no embeddings endpoint).
# Each provider is one of: openai | ollama | bedrock.
#
# Recommended on Mac: run both via local Ollama (see .env.mac.example).
#   brew install ollama   # or install from https://ollama.com
#   npm run mac:models    # pulls chat + embed models
#   npm run db:up && npm run api:dev

# --- Generation (answer + classification) ---
#   openai  — any OpenAI-compatible server (vLLM, LM Studio, LiteLLM, …)
#   ollama  — an Ollama server (/api/chat)
#   bedrock — AWS Bedrock Converse
GEN_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5
# OpenAI-compatible chat (GEN_PROVIDER=openai), e.g. remote vLLM:
# OPENAI_BASE_URL=http://localhost:8001/v1
# OPENAI_CHAT_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# OPENAI_API_KEY=not-needed
# Bedrock chat (GEN_PROVIDER=bedrock):
RAG_MODEL_ID=us.amazon.nova-2-lite-v1:0

# --- Embeddings ---
#   openai  — OpenAI-compatible /v1/embeddings (e.g. a vLLM/TEI embed server)
#   ollama  — Ollama /api/embeddings
#   bedrock — Amazon Titan
# EMBED_DIM MUST match the VECTOR(n) column in db.py; changing it recreates that
# column only on a fresh DB (existing VECTOR dims are not auto-migrated).
EMBED_PROVIDER=ollama
EMBED_BASE_URL=http://localhost:11434
EMBED_MODEL_ID=mxbai-embed-large
EMBED_DIM=1024
# Alternate local embed (768-dim) if you already have it pulled:
# EMBED_MODEL_ID=nomic-embed-text
# EMBED_DIM=768

# AWS region for Bedrock (only when GEN/EMBED provider = bedrock).
# Credentials resolve via the standard AWS chain (env vars, SSO, instance role).
AWS_REGION=us-east-1

# --- Langfuse (optional LLM observability) ---
# Local-friendly: leave unset → tracing is a no-op; chat/metrics still work.
# Easiest path: free Langfuse Cloud project → paste keys here.
# Self-host: see infra/langfuse/README.md (UI typically http://localhost:3100).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_ENABLED=true
# LANGFUSE_TRACING_ENVIRONMENT=development

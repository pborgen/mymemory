# Mac-local profile: API + Postgres on this machine, models via local Ollama.
# Copy over .env (or merge) when developing without the Tailscale GPU box:
#   cp .env.mac.example .env
#
# Prerequisites:
#   1. Docker Desktop running → npm run db:up
#   2. Ollama app/CLI running → npm run mac:models

POSTGRES_URL=postgresql://postgres:postgres@localhost:5544/mymemory
PORT=8080
ALLOW_DEV_AUTH_HEADERS=true
SUPER_ADMIN_EMAIL=paul@dev.local
GOOGLE_CLIENT_ID=

# Optional prompt cache — leave unset, or: npm run db:up -- --profile redis
# REDIS_URL=redis://localhost:6379/0

# --- Generation: local Ollama chat model ---
GEN_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5

# --- Embeddings: local Ollama (1024-dim, matches VECTOR(1024)) ---
EMBED_PROVIDER=ollama
EMBED_BASE_URL=http://localhost:11434
EMBED_MODEL_ID=mxbai-embed-large
EMBED_DIM=1024

# Bedrock unused in this profile (kept for easy switching).
AWS_REGION=us-east-1
RAG_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Langfuse optional — leave blank for a no-op tracer.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Base URL of the MyMemory FastAPI backend. Exposed to the browser, so it must
# be reachable from the user's machine (not a container-internal hostname).
#
# Local:
#   NEXT_PUBLIC_API_URL=http://localhost:8080
# Prod (Vercel → App Runner custom domain — see infra/DOMAINS.md):
#   NEXT_PUBLIC_API_URL=https://api.memory.informedbydata.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# Canonical site URL (Open Graph / metadata). On Vercel:
#   NEXT_PUBLIC_SITE_URL=https://memory.informedbydata.com
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
